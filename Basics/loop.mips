.data
    sum: .word 0   # create an integer variable (sum) and initzalize it with the value 0 
    i: .word 1     # create an integer variable (i) and initzalize it with the value 1

.text
    li $t0, 5  # load immediate the value of 5 to register $t0 (it will be used for loop comparison)    
    lw $t1, i  # 
    lw $t2, sum   

Loop1:
    ble $t1, $t0, ContinueLoop  
    j Exit                      

ContinueLoop:
    add $t2, $t2, $t1   
    addi $t1, $t1, 1     
    sw $t2, sum         
    j Loop1             

Exit:
    li $v0, 1          
    lw $a0, sum         
    syscall             
